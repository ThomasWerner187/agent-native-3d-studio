# This file supplements Plesk's password protection. Do not replace the
# authentication directives generated by Plesk when installing it.
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set Origin-Agent-Cluster "?1"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.html$">
    Header always set Cache-Control "private, max-age=0, must-revalidate"
  </FilesMatch>

  # Vite fingerprinted assets may be cached across releases.
  <FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|webp|svg|avif)$">
    Header always set Cache-Control "private, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# No SPA rewrite: the application uses query strings and URL fragments.
